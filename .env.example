# Database — get from Railway (postgresql://...)
DATABASE_URL="postgresql://user:password@host:5432/spendsmart"

# JWT secrets — generate with: openssl rand -base64 32
ACCESS_TOKEN_SECRET="your-access-token-secret-min-32-chars"
REFRESH_TOKEN_SECRET="your-refresh-token-secret-min-32-chars"

# Upstash Redis — get from upstash.com (free tier)
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# AWS S3 — for receipt photo uploads (optional for MVP)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET="spendsmart-receipts"
